---
import Layout from '../layouts/Layout.astro';
import { showcaseProjects as projects } from '../data/showcase-projects';

function parseMonthYear(value?: string) {
  return value ? new Date(value).getTime() : 0;
}

const sortedProjects = [...projects].sort(
  (a, b) => parseMonthYear(b.made) - parseMonthYear(a.made)
);

const kinds: Record<string, { label: string }> = {
  'Automating 3D Survival Playing': { label: 'Game-playing agent' },
  'Automatic UI Fixing Harness': { label: 'Agent tooling' },
  'Understanding Prime Env Skill': { label: 'RL environment' },
  'Price Negotiation RL': { label: 'RL environment' },
  'Maze Bench': { label: 'RL environment' },
  'MakeMyDocsBot': { label: 'Agent tooling' },
  'RLM Demo': { label: 'RL environment' },
};
const kindFor = (name: string) => kinds[name] ?? { label: 'Project' };
---
<Layout title="Projects — Vidit Ostwal">
<div class="page projects-page">

  <div class="page-header">
    <h1>Projects</h1>
    <p class="sub">Things I've built: agents that act on their own, and environments to train them in. Tap a project to read the full story.</p>
  </div>

  <div class="grid">
    {sortedProjects.map((p, i) => {
      const kind = kindFor(p.name);
      const id = `proj-${i}`;
      return (
        <article class:list={['tile', i === 0 && 'is-open']}>
          <button type="button" class="tile-head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={id}>
            <span class="tile-top">
              <span class="chip">{kind.label}</span>
              {p.made && <span class="tile-date">{p.made}</span>}
            </span>
            <span class="tile-name">{p.name}</span>
            <span class="tile-tag">{p.tagline}</span>
            <span class="tile-toggle">
              <span class="tile-toggle-label">{i === 0 ? 'Show less' : 'Read the full story'}</span>
              <svg class="chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6"/></svg>
            </span>
          </button>

          <div class="tile-body" id={id}>
            <div class="tile-body-inner">
              <ul class="bullets">
                {p.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>

          <ul class="tile-links">
            <li>
              <a href={p.github} target="_blank" rel="noopener" class="tlink">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                <span>GitHub</span>
              </a>
            </li>
            {p.liveLink && (
              <li><a href={p.liveLink} target="_blank" rel="noopener" class="tlink tlink--accent"><span>Live demo</span></a></li>
            )}
            {p.xPost && (
              <li><a href={p.xPost} target="_blank" rel="noopener" class="tlink"><span>Launch post</span></a></li>
            )}
          </ul>
        </article>
      );
    })}
  </div>

</div>
</Layout>

<script>
  const tiles = document.querySelectorAll<HTMLElement>('.tile');

  function setOpen(tile: HTMLElement, open: boolean) {
    tile.classList.toggle('is-open', open);
    const head = tile.querySelector<HTMLButtonElement>('.tile-head');
    const label = tile.querySelector<HTMLElement>('.tile-toggle-label');
    head?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Show less' : 'Read the full story';
  }

  tiles.forEach((tile) => {
    tile.querySelector('.tile-head')?.addEventListener('click', () => {
      const willOpen = !tile.classList.contains('is-open');
      // One open at a time keeps the grid tidy
      tiles.forEach((t) => setOpen(t, false));
      setOpen(tile, willOpen);
      if (willOpen) {
        requestAnimationFrame(() => tile.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
      }
    });
  });
</script>

<style>
  .projects-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 6rem 1.5rem 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
    align-items: stretch;
  }

  .tile {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .tile.is-open {
    grid-column: 1 / -1;
    border-color: var(--text-3);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
  }
  @media (hover: hover) {
    .tile:not(.is-open):hover { border-color: var(--text-3); }
  }

  .tile-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    width: 100%;
    padding: 1.25rem 1.35rem 0.5rem;
    text-align: left;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 12px 12px 0 0;
    cursor: pointer;
  }
  .tile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
  }
  .tile-date { font-family: "IBM Plex Mono", monospace; font-size: 0.72rem; color: var(--text-3); }
  .tile-name {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--text);
  }
  .tile-tag { font-size: 0.9rem; color: var(--text-2); line-height: 1.7; }

  .tile-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    min-height: 2rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .chev { width: 0.95rem; height: 0.95rem; transition: transform 0.25s ease; }
  .tile.is-open .chev { transform: rotate(180deg); }

  /* Smooth height animation without measuring: 0fr → 1fr */
  .tile-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .tile.is-open .tile-body { grid-template-rows: 1fr; }
  .tile-body-inner { overflow: hidden; min-height: 0; padding: 0 1.35rem; }
  .tile.is-open .tile-body-inner { padding-top: 0.6rem; padding-bottom: 0.4rem; }
  .bullets li { font-size: 0.9rem; line-height: 1.7; }
  .bullets { gap: 0.6rem; }

  .tile-links {
    margin-top: auto;
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.45rem;
    padding: 0.5rem 1.35rem 1.25rem;
  }
  .tlink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.75rem;
    white-space: nowrap;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 7px;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .tlink svg { width: 0.95rem; height: 0.95rem; }
  .tlink:hover { color: var(--text); border-color: var(--text-3); }
  .tlink--accent { color: var(--text); border-color: var(--text-3); }

  @media (min-width: 900px) {
    .tile.is-open .bullets { columns: 2; column-gap: 2.5rem; display: block; }
    .tile.is-open .bullets li { break-inside: avoid; margin-bottom: 0.6rem; }
  }

  @media (max-width: 640px) {
    .projects-page { padding: 5.5rem 1.1rem 2.5rem; }
    .grid { grid-template-columns: 1fr; }
    .tlink { padding: 0.3rem 0.6rem; font-size: 0.68rem; gap: 0.3rem; white-space: nowrap; }
    .tile-links { gap: 0.35rem; }
    .tile-head { padding: 1.1rem 1.1rem 0.4rem; }
    .tile-body-inner { padding: 0 1.1rem; }
    .tile-links { padding: 0.5rem 1.1rem 1.1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile, .tile-body, .chev { transition: none; }
  }
</style>
