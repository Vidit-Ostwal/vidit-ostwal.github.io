---
import Layout from '../layouts/Layout.astro';
import { showcaseProjects as projects } from '../data/showcase-projects';

function parseMonthYear(value?: string) {
  return value ? new Date(value).getTime() : 0;
}

const sortedProjects = [...projects].sort(
  (a, b) => parseMonthYear(b.made) - parseMonthYear(a.made)
);

const kinds: Record<string, { label: string }> = {
  'Automating 3D Survival Playing': { label: 'Game-playing agent' },
  'Automatic UI Fixing Harness': { label: 'Agent tooling' },
  'Understanding Prime Env Skill': { label: 'RL environment' },
  'Price Negotiation RL': { label: 'RL environment' },
  'Maze Bench': { label: 'RL environment' },
  'MakeMyDocsBot': { label: 'Agent tooling' },
  'RLM Demo': { label: 'RL environment' },
};
const kindFor = (name: string) => kinds[name] ?? { label: 'Project' };
---
<Layout title="Projects — Vidit Ostwal">
<div class="page projects-page">

  <div class="page-header">
    <h1>Projects</h1>
    <p class="sub">Things I've built: agents that act on their own, and environments to train them in.</p>
  </div>

  <div class="grid">
    {sortedProjects.map((p, i) => {
      const kind = kindFor(p.name);
      return (
        <article class:list={['tile', i === 0 && 'tile--featured']}>
          <div class="tile-top">
            <span class="chip">{kind.label}</span>
            {p.made && <span class="tile-date">{p.made}</span>}
          </div>
          <div class="tile-main">
          <h2 class="tile-name">{p.name}</h2>
          <p class="tile-tag">{p.tagline}</p>
          <ul class="tile-links">
            <li>
              <a href={p.github} target="_blank" rel="noopener" class="tlink">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                <span>GitHub</span>
              </a>
            </li>
            {p.liveLink && (
              <li><a href={p.liveLink} target="_blank" rel="noopener" class="tlink tlink--accent"><span>Live demo</span></a></li>
            )}
            {p.xPost && (
              <li><a href={p.xPost} target="_blank" rel="noopener" class="tlink"><span>Launch post</span></a></li>
            )}
          </ul>
          </div>
          {i === 0 ? (
            <ul class="bullets tile-bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
          ) : (
          <details class="more">
            <summary>How it works ({p.bullets.length})</summary>
            <ul class="bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </details>
          )}
        </article>
      );
    })}
  </div>

</div>
</Layout>

<style>
  .projects-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 6rem 1.5rem 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .tile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .tile-date { font-size: 0.82rem; font-weight: 600; color: var(--text-3); }

  .tile-name {
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--text);
  }
  .tile-tag { font-size: 0.96rem; color: var(--text-2); line-height: 1.6; }

  .tile-main { display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .tile-bullets { display: none; }

  /* Lead with the newest project: full-width, details always visible */
  .tile--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 0.75rem 2.5rem;
    padding: 1.9rem;
  }
  .tile--featured .tile-top { grid-column: 1 / -1; }
  .tile--featured .tile-name { font-size: 1.45rem; }
  .tile--featured .tile-tag { font-size: 1.05rem; }
  .tile--featured .tile-bullets { display: flex; align-self: start; }
  .tile--featured .tile-bullets li { font-size: 0.95rem; }

  .tile-links { margin-top: auto; list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .tlink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.75rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 7px;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .tlink svg { width: 0.95rem; height: 0.95rem; }
  .tlink:hover { color: var(--text); border-color: var(--text-3); }
  .tlink--accent { color: var(--text); border-color: var(--text-3); }

  .more summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2.5px solid currentColor;
    border-bottom: 2.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s;
  }
  .more[open] summary::before { transform: rotate(45deg); }
  .more .bullets { margin-top: 0.5rem; }
  .more .bullets li { font-size: 0.9rem; }

  @media (hover: hover) {
    .tile:hover { border-color: var(--text-3); transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,0.05); }
  }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 860px) {
    .tile--featured { grid-template-columns: 1fr; padding: 1.4rem; }
    .tile--featured .tile-name { font-size: 1.25rem; }
    .tile--featured .tile-bullets { margin-top: 0.25rem; }
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }

  @media (--mobile) {
    .projects-page { padding: 5.5rem 1.1rem 2.5rem; }
    .tile { padding: 1.15rem; border-radius: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile, .more summary::before { transition: none; }
  }
</style>
