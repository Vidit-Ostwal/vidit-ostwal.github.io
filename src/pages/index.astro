---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { education, experience } from '../data/experience';
import { showcaseProjects } from '../data/showcase-projects';
import { substackPosts } from '../data/projects';

const now = experience.find((r) => r.current) ?? experience[0];
const levels = education.length + experience.length;
const categories = [...new Set(substackPosts.map((p) => p.category))];
const recentProjects = [...showcaseProjects]
  .sort((a, b) => new Date(b.made ?? 0).getTime() - new Date(a.made ?? 0).getTime())
  .slice(0, 3);

const links = [
  {
    label: 'GitHub', href: 'https://github.com/Vidit-Ostwal',
    icon: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  },
  {
    label: 'LinkedIn', href: 'https://www.linkedin.com/in/viditostwal/',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: 'X', href: 'https://x.com/ViditOstwal',
    icon: '<path d="M4 4l16 16M20 4L4 20"/>',
  },
  {
    label: 'Email', href: 'mailto:viditostwal@gmail.com',
    icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
  },
];

---

<Layout title="Vidit Ostwal" description="ML/AI Engineer building agentic AI systems and RL environments.">
<div class="page">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-copy">
      <img class="avatar" src={withBase('/photo.png')} alt="Vidit Ostwal" width="220" height="220" />
      <h1>Vidit Ostwal</h1>
      <p class="lede">I build the frameworks agents run on, and the environments they learn in.</p>
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="pill">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
              <span>{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <figure class="world">
      <canvas
        id="gridworld"
        role="img"
        aria-label="Animated gridworld: a reinforcement-learning agent explores a maze and learns the shortest path to a star. Tap a cell to move a wall."
      ></canvas>
      <figcaption>
        <span class="blinker" aria-hidden="true"></span>
        <span class="hud mono" id="gridworld-hud" aria-hidden="true">env 1 · episode 1</span>
      </figcaption>
      <p class="world-hint">A tiny RL agent learning its maze. Tap a cell to move a wall and watch it re-plan.</p>
    </figure>
  </section>

  <!-- NOW -->
  <a class="now" href={withBase('/experience')}>
    <span class="blinker" aria-hidden="true"></span>
    <span class="now-text">
      <strong>Right now:</strong> {now.title} at {now.company}, since {now.start}. {now.bullets[0]}
    </span>
    <span class="now-go mono">See the map</span>
  </a>

  <!-- EXPLORE -->
  <section class="section">
    <h2>Explore</h2>
    <div class="doors">
      <a class="door" href={withBase('/experience')}>
        <p class="door-kicker mono">Experience</p>
        <h3>Walk my career as a level map</h3>
        <p class="door-text">{levels} levels, from engineering college to CrewAI. Tap a level to see what I was doing there.</p>
        <span class="door-dots" aria-hidden="true">
          {Array.from({ length: levels }).map((_, i) => (
            <span class:list={['dot', i === levels - 1 && 'dot--now']}></span>
          ))}
          <span class="dot dot--locked"></span>
          <span class="dot dot--locked"></span>
        </span>
        <span class="door-go mono">Open the map</span>
      </a>

      <a class="door" href={withBase('/projects')}>
        <p class="door-kicker mono">Projects</p>
        <h3>Agents and RL environments I've built</h3>
        <p class="door-text">{showcaseProjects.length} projects. Tap one to read how it works.</p>
        <ul class="door-chips" aria-hidden="true">
          {recentProjects.map((p) => <li class="chip">{p.name}</li>)}
        </ul>
        <span class="door-go mono">See the projects</span>
      </a>

      <a class="door" href={withBase('/blog')}>
        <p class="door-kicker mono">Writing</p>
        <h3>What I'm learning, with visuals</h3>
        <p class="door-text">{substackPosts.length} posts that explain how LLMs work, one picture at a time.</p>
        <ul class="door-chips" aria-hidden="true">
          {categories.slice(0, 3).map((c) => <li class="chip">{c}</li>)}
        </ul>
        <span class="door-go mono">Read the posts</span>
      </a>
    </div>
  </section>

</div>
</Layout>

<script>
  import { initGridworld } from '../scripts/gridworld';

  const canvas = document.getElementById('gridworld') as HTMLCanvasElement | null;
  if (canvas) initGridworld(canvas, document.getElementById('gridworld-hud'));
</script>

<style>
  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 6rem 1.5rem 3rem;
  }
  .mono { font-family: "IBM Plex Mono", monospace; }

  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .avatar {
    display: block;
    width: clamp(150px, 20vw, 220px);
    height: clamp(150px, 20vw, 220px);
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--border);
    margin: 0.25rem 0 1.75rem 0.25rem;
  }

  h1 {
    font-family: "Lora", Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text);
    margin-bottom: 0.9rem;
  }

  .lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 26rem;
    margin-bottom: 1.5rem;
  }

  .links { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--text-2);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 7px;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .pill:hover { color: var(--text); border-color: var(--text-3); background: var(--surface); }

  /* ── Game ── */
  .world {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 0.75rem 0.65rem;
  }
  #gridworld {
    display: block;
    width: 100%;
    aspect-ratio: 13 / 9;
    border-radius: 8px;
    background: var(--surface);
    cursor: pointer;
    touch-action: manipulation;
  }
  .world figcaption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.2rem 0.1rem;
  }
  .hud {
    font-size: 0.72rem;
    color: var(--text-2);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .world-hint { font-size: 0.8rem; color: var(--text-3); padding: 0.2rem 0.2rem 0; }

  /* ── Now ── */
  .now {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.95rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    margin-bottom: 3.5rem;
    transition: border-color 0.15s;
  }
  .now:hover { border-color: var(--text-3); }
  .now .blinker { margin-top: 0.5rem; }
  .now-text { flex: 1; min-width: 0; font-size: 0.9rem; line-height: 1.7; color: var(--text-2); }
  .now-text strong { color: var(--text); font-weight: 600; }
  .now-go {
    flex-shrink: 0;
    align-self: center;
    font-size: 0.72rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  /* ── Sections ── */
  .section { margin-bottom: 3.5rem; }
  h2 {
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 1.25rem;
  }
  h3 { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; color: var(--text); }

  /* ── Explore doors ── */
  .doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .door {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1.3rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .door-kicker { font-size: 0.72rem; color: var(--text-3); }
  .door-text { font-size: 0.9rem; line-height: 1.7; color: var(--text-2); }
  .door-go {
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.72rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (hover: hover) {
    .door:hover { border-color: var(--text-3); box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06); transform: translateY(-2px); }
  }

  .door-dots { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.15rem 0; }
  .dot { width: 14px; height: 14px; border-radius: 50%; background: var(--text); }
  .dot--now { background: var(--bg); border: 3px solid var(--text); animation: now-pulse 2.2s ease-out infinite; }
  .dot--locked { background: transparent; border: 2px dashed var(--text-3); }
  @keyframes now-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--text) 35%, transparent); }
    70%  { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .door-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.15rem 0; }
  .chip {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--text-2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.18rem 0.5rem;
    line-height: 1.3;
  }

  /* ── Tablet / mobile ── */
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .doors { grid-template-columns: 1fr; }
  }

  @media (--mobile) {
    .page { padding: 5.5rem 1.1rem 2.5rem; }
    .avatar { width: 150px; height: 150px; }
    .now { flex-wrap: wrap; }
    .now-go { margin-left: 1.4rem; }
    .section { margin-bottom: 2.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot--now { animation: none; }
    .door { transition: none; }
  }
</style>
