---
import Layout from '../../layouts/Layout.astro';
import { substackPosts } from '../../data/projects';

const sortedPosts = [...substackPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const categories = [...new Set(sortedPosts.map((post) => post.category))];

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

function fmtDateShort(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---
<Layout title="Blog — Vidit Ostwal">
<div class="page blog-page">

  <div class="page-header">
    <h1>Writing</h1>
    <p class="sub">I share what I'm learning, with visuals wherever I can.</p>
  </div>

  <div class="filters" role="group" aria-label="Filter by category">
    <button type="button" class="filter-btn is-active" data-filter="all">All</button>
    {categories.map((category) => (
      <button type="button" class="filter-btn" data-filter={category}>{category}</button>
    ))}
  </div>

  <div class="grid">
    {sortedPosts.map((post) => (
      <a
        href={post.url}
        {...(post.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
        class="post"
        data-category={post.category}
      >
        <div class="post-top">
          <span class="chip">{post.category}</span>
          <span class="post-date">{fmtDate(post.date)}</span>
        </div>
        <h2 class="post-title">{post.title}</h2>
        {post.summary && <p class="post-summary">{post.summary}</p>}
        <span class="post-read">Read the post</span>
      </a>
    ))}
  </div>

  <p class="empty-state" hidden>No posts match this filter.</p>

</div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('.post');
  const emptyState = document.querySelector<HTMLElement>('.empty-state');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      filterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));

      let visibleCount = 0;
      rows.forEach((row) => {
        const show = filter === 'all' || row.dataset.category === filter;
        row.hidden = !show;
        if (show) visibleCount += 1;
      });

      if (emptyState) emptyState.hidden = visibleCount > 0;
    });
  });
</script>

<style>
  .blog-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 6rem 1.5rem 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .post[hidden] { display: none; }
  .post-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .post-date { font-size: 0.82rem; font-weight: 600; color: var(--text-3); }
  .post-title {
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--text);
  }
  .post-summary { font-size: 0.96rem; color: var(--text-2); line-height: 1.6; }
  .post-read {
    margin-top: auto;
    padding-top: 0.25rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  @media (hover: hover) {
    .post:hover { border-color: var(--text-3); transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,0.05); }
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
  }

  @media (--mobile) {
    .blog-page { padding: 5.5rem 1.1rem 2.5rem; }
    .post { padding: 1.15rem; border-radius: 10px; }
    .filters { flex-wrap: nowrap; overflow-x: auto; margin-inline: -1.1rem; padding: 0 1.1rem 0.4rem; scrollbar-width: none; }
    .filter-btn { flex: 0 0 auto; white-space: nowrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post { transition: none; }
  }
</style>
