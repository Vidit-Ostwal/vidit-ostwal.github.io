---
import Layout from '../layouts/Layout.astro';
import MobileTimelineNav from '../components/MobileTimelineNav.astro';
import {
  experience,
  formatDateRange,
  formatDuration,
  groupExperienceByCompany,
  type EmploymentType,
} from '../data/experience';

const employmentTypeOrder: EmploymentType[] = ['Full Time', 'Part Time', 'Contract', 'Internship'];
const employmentTypes = employmentTypeOrder.filter((type) =>
  experience.some((role) => role.employmentType === type)
);

const companyGroups = groupExperienceByCompany(experience);

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Highlight impact numbers (500,000+, 30%, ~40%, 320+) inside a bullet. */
const withNumbers = (t: string) =>
  esc(t).replace(/(~?\d[\d,]*\s?%|\d[\d,]*\+)/g, '<mark class="num">$1</mark>');
---

<Layout title="Experience — Vidit Ostwal">
<div class="page timeline-page">

  <div class="fade-in header">
    <h1>Experience</h1>
    <p class="sub">Roles and what I built.</p>
  </div>

  <div class="fade-in filters" role="group" aria-label="Filter by employment type">
    <button type="button" class="filter-btn mono is-active" data-filter="all">All</button>
    {employmentTypes.map((type) => (
      <button type="button" class="filter-btn mono" data-filter={type}>{type}</button>
    ))}
  </div>

  <div class="timeline-wrap">
    <div class="timeline-spine" aria-hidden="true"></div>

    {companyGroups.map((group) => (
      <div class="company-group" data-company={group.company}>
        {group.roles.map((role, roleIndex) => {
          const isFirstInCompany = roleIndex === 0;
          const isContinued = roleIndex > 0;
          const dateRange = formatDateRange(role.start, role.end);
          const duration = formatDuration(role.start, role.end, role.current);

          return (
            <div
              class:list={['fade-in', 'timeline-row', role.current && 'timeline-row--current', isContinued && 'timeline-row--continued']}
              data-employment-type={role.employmentType}
              data-nav-label={role.title}
              data-nav-date={role.end}
              data-nav-end={role.end}
              data-nav-start={role.start}
            >
              <div class="timeline-side">
                <div class="tl-dates mono">
                  <span class="tl-range">
                    <span class="tl-range-start">{role.start}</span>
                    <span class="tl-range-end">{role.end}</span>
                  </span>
                  <span class="tl-duration">{duration}</span>
                  {role.current && <span class="tl-badge mono">Current</span>}
                </div>
                <div class="tl-marker">
                  <span class:list={['tl-dot', role.current && 'tl-dot--current']}></span>
                </div>
              </div>

              <article class:list={['timeline-card', 'role-card', role.current && 'role-card--current', role.current && 'is-open', role.bullets.length < 2 && 'role-card--static', isContinued && 'role-card--continued']}>
                <div class="role-header">
                  <p class="tl-dates-mobile mono">
                    {dateRange}
                    <span class="tl-duration-mobile"> · {duration}</span>
                    {role.current && <span class="tl-badge mono tl-badge--inline">Current</span>}
                  </p>

                  <div class="role-card-top">
                    <h2 class="role-title">{role.title}</h2>
                    <span class="role-tag mono">{role.employmentType}</span>
                  </div>

                  {isFirstInCompany ? (
                    <p class="role-company">
                      {group.companyUrl ? (
                        <a href={group.companyUrl} target="_blank" rel="noopener" class="company-link">{group.company}</a>
                      ) : (
                        group.company
                      )}
                    </p>
                  ) : (
                    <p class="role-company role-company--continued">
                      Earlier role at{' '}
                      {group.companyUrl ? (
                        <a href={group.companyUrl} target="_blank" rel="noopener" class="company-link">{group.company}</a>
                      ) : (
                        group.company
                      )}
                    </p>
                  )}
                </div>

                {role.bullets.length > 1 ? (
                  <>
                    <p class="role-preview" aria-hidden="true" set:html={withNumbers(role.bullets[0])} />
                    <div class="role-body" id={`role-${group.company.replace(/\W+/g, '')}-${roleIndex}`}>
                      <div class="role-body-inner">
                        <ul class="bullets">
                          {role.bullets.map((b) => <li set:html={withNumbers(b)} />)}
                        </ul>
                      </div>
                    </div>
                    <button
                      type="button"
                      class="role-toggle mono"
                      aria-expanded={role.current ? 'true' : 'false'}
                      aria-controls={`role-${group.company.replace(/\W+/g, '')}-${roleIndex}`}
                    >
                      <span class="role-toggle-label">{role.current ? 'Show less' : 'Read the full story'}</span>
                      <svg class="chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6"/></svg>
                    </button>
                  </>
                ) : (
                  <ul class="bullets">
                    {role.bullets.map((b) => <li set:html={withNumbers(b)} />)}
                  </ul>
                )}
              </article>
            </div>
          );
        })}
      </div>
    ))}
  </div>

  <MobileTimelineNav ariaLabel="Jump between roles" />

  <p class="empty-state mono" hidden>No roles match this filter.</p>

</div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('.timeline-row');
  const groups = document.querySelectorAll<HTMLElement>('.company-group');
  const emptyState = document.querySelector<HTMLElement>('.empty-state');

  // Click a role to read its full story; one open at a time
  const cards = document.querySelectorAll<HTMLElement>('.role-card:not(.role-card--static)');
  function setOpen(card: HTMLElement, open: boolean) {
    card.classList.toggle('is-open', open);
    const btn = card.querySelector<HTMLButtonElement>('.role-toggle');
    const label = card.querySelector<HTMLElement>('.role-toggle-label');
    btn?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Show less' : 'Read the full story';
  }
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const willOpen = !card.classList.contains('is-open');
      cards.forEach((c) => setOpen(c, false));
      setOpen(card, willOpen);
      document.dispatchEvent(new CustomEvent('timeline-rows-changed'));
    });
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      filterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));

      let visibleCount = 0;
      rows.forEach((row) => {
        const show = filter === 'all' || row.dataset.employmentType === filter;
        row.classList.toggle('is-hidden', !show);
        if (show) visibleCount += 1;
      });

      groups.forEach((group) => {
        const hasVisible = group.querySelectorAll('.timeline-row:not(.is-hidden)').length > 0;
        group.classList.toggle('is-hidden', !hasVisible);
      });

      if (emptyState) emptyState.hidden = visibleCount > 0;
      document.dispatchEvent(new CustomEvent('timeline-rows-changed'));
    });
  });
</script>

<style>
  .header { margin-bottom: 1.75rem; }
  h1 { font-size: 1.9rem; font-weight: 600; letter-spacing: -0.025em; color: #111111; margin-bottom: 0.35rem; }
  .sub { font-size: 0.88rem; color: #999999; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
  }

  .filter-btn {
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: #555555;
    background: #ffffff;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .filter-btn:hover {
    color: #111111;
    border-color: #c8c8c8;
    background: #f7f7f7;
  }
  .filter-btn.is-active {
    color: #ffffff;
    background: #111111;
    border-color: #111111;
  }

  .empty-state {
    font-size: 0.78rem;
    color: #999999;
    text-align: center;
    padding: 2rem 0 0.5rem;
  }

  .mono { font-family: "IBM Plex Mono", monospace; }

  .company-group {
    display: contents;
  }
  .company-group.is-hidden {
    display: none;
  }

  .timeline-row--continued {
    margin-top: -0.35rem;
  }

  .tl-badge--inline {
    display: inline-block;
    margin: 0 0 0 0.4rem;
    vertical-align: middle;
  }

  .role-header {
    margin-bottom: 0.85rem;
  }

  .role-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-bottom: 0.2rem;
  }

  .role-title {
    flex: 1;
    min-width: 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: #111111;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0;
  }

  .role-tag {
    flex-shrink: 0;
    max-width: 45%;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: #555555;
    border: 1px solid #e4e4e4;
    border-radius: 3px;
    padding: 0.18rem 0.55rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .role-company {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.55;
    margin: 0;
  }

  .role-company--continued {
    font-size: 0.8rem;
    color: #888888;
  }

  .company-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: #c8c8c8;
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  .company-link:hover {
    color: #111111;
    text-decoration-color: #888888;
  }

  .role-card--current {
    border-color: #c0c0c0;
    box-shadow: inset 3px 0 0 #111111;
  }

  .bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
  }
  .bullets li {
    font-size: 0.9rem;
    color: #555555;
    line-height: 1.7;
    padding-left: 1rem;
    position: relative;
  }
  .bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: #cccccc;
  }

  .bullets :global(.num) {
    font-weight: 600;
    color: #111111;
    background: #f1efe9;
    border-radius: 3px;
    padding: 0 0.2em;
  }

  .role-card:not(.role-card--static) { cursor: pointer; }

  /* Collapsed: a two-line preview of the first highlight */
  .role-preview {
    margin: 0;
    font-size: 0.9rem;
    color: #555555;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .role-card.is-open .role-preview { display: none; }
  .role-preview :global(.num) {
    font-weight: 600;
    color: #111111;
    background: #f1efe9;
    border-radius: 3px;
    padding: 0 0.2em;
  }

  /* Smooth height animation: 0fr -> 1fr */
  .role-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .role-card.is-open .role-body { grid-template-rows: 1fr; }
  .role-body-inner { overflow: hidden; min-height: 0; }

  .role-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    margin-top: 0.5rem;
    padding: 0;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: #111111;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .chev { width: 0.95rem; height: 0.95rem; transition: transform 0.25s ease; }
  .role-card.is-open .chev { transform: rotate(180deg); }

  @media (--mobile) {
    .timeline-row--continued { margin-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .role-body, .chev { transition: none; }
  }

  :global([data-theme="dark"]) h1 { color: #e8e8e8; }
  :global([data-theme="dark"]) .sub { color: #555555; }
  :global([data-theme="dark"]) .filter-btn {
    color: #909090;
    background: #1a1a1a;
    border-color: #2a2a2a;
  }
  :global([data-theme="dark"]) .filter-btn:hover {
    color: #e0e0e0;
    border-color: #484848;
    background: #222222;
  }
  :global([data-theme="dark"]) .filter-btn.is-active {
    color: #111111;
    background: #e8e8e8;
    border-color: #e8e8e8;
  }
  :global([data-theme="dark"]) .empty-state { color: #555555; }
  :global([data-theme="dark"]) .role-title { color: #e0e0e0; }
  :global([data-theme="dark"]) .role-tag {
    color: #707070;
    border-color: #2a2a2a;
  }
  :global([data-theme="dark"]) .role-company { color: #808080; }
  :global([data-theme="dark"]) .role-company--continued { color: #555555; }
  :global([data-theme="dark"]) .company-link { text-decoration-color: #3a3a3a; }
  :global([data-theme="dark"]) .company-link:hover {
    color: #e0e0e0;
    text-decoration-color: #707070;
  }
  :global([data-theme="dark"]) .role-card--current {
    border-color: #484848;
    box-shadow: inset 3px 0 0 #e8e8e8;
  }
  :global([data-theme="dark"]) .bullets li { color: #909090; }
  :global([data-theme="dark"]) .bullets li::before { color: #3a3a3a; }
  :global([data-theme="dark"]) .bullets :global(.num) { color: #e8e8e8; background: #2a2a2a; }
  :global([data-theme="dark"]) .role-toggle { color: #e0e0e0; }
  :global([data-theme="dark"]) .role-preview { color: #909090; }
  :global([data-theme="dark"]) .role-preview :global(.num) { color: #e8e8e8; background: #2a2a2a; }
</style>
